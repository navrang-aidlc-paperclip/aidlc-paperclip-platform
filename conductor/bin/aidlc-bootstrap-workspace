#!/usr/bin/env bash
# Clone or fast-forward the AI-DLC workspace root and its repos.json siblings,
# then make sure the pinned framework surface is present and healthy.
#
# Idempotent; safe to run at container start and at the start of every
# conductor wake (the conductor skill calls it first thing).
#
# Env:
#   AIDLC_WORKSPACES_ROOT   parent dir (default /paperclip/workspaces)
#   AIDLC_WORKSPACE_REPO    https clone URL of aidlc-workspace
#   AIDLC_WORKSPACE_NAME    checkout dir name (default aidlc-workspace)
#   AIDLC_WORKSPACE_BRANCH  branch to track (default main)
#   GITHUB_APP_* / GITHUB_TOKEN  see git-credential-github-app
set -euo pipefail

root="${AIDLC_WORKSPACES_ROOT:-/paperclip/workspaces}"
repo="${AIDLC_WORKSPACE_REPO:?AIDLC_WORKSPACE_REPO is required}"
name="${AIDLC_WORKSPACE_NAME:-aidlc-workspace}"
branch="${AIDLC_WORKSPACE_BRANCH:-main}"
dir="$root/$name"

log() { printf 'aidlc-bootstrap: %s\n' "$*" >&2; }

mkdir -p "$root"

if [ ! -d "$dir/.git" ]; then
  log "cloning $repo -> $dir"
  git clone --branch "$branch" "$repo" "$dir"
else
  log "refreshing $dir ($branch)"
  git -C "$dir" fetch --quiet origin "$branch"
  # Never discard local work the conductor has not pushed yet.
  if git -C "$dir" diff --quiet && git -C "$dir" diff --cached --quiet; then
    git -C "$dir" merge --ff-only "origin/$branch" || log "non-fast-forward; leaving checkout as is"
  else
    log "checkout has uncommitted changes; skipping merge"
  fi
fi

cd "$dir"

# Pin check: the image carries exactly one aidlc release; the repo must agree.
want="$(cat .aidlc-version 2>/dev/null || true)"
have="$(aidlc --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
if [ -n "$want" ] && [ "$want" != "$have" ]; then
  log "WARNING: workspace pins aidlc $want but image has $have; rebuild the image with AIDLC_VERSION=$want"
fi
# The pin's machine-local target (aidlc/.aidlc-sessions/pin-target, pins.json
# under AIDLC_INSTALL_ROOT) is gitignored, so a fresh clone must register it
# here. The release is already installed in the image; nothing is downloaded.
if [ -n "$want" ]; then
  aidlc config --pin "$want" --project-dir "$dir" --quiet || log "WARNING: could not register pin $want"
fi

# Headless Claude Code only runs project hooks once the folder is trusted and
# hooks are not disabled. Materialise the per-machine local settings file the
# repo gitignores.
mkdir -p .claude
if [ ! -f .claude/settings.local.json ]; then
  cat > .claude/settings.local.json <<'JSON'
{
  "disableAllHooks": false
}
JSON
fi

# Sibling source repos declared in repos.json. Non-fatal: a repo that cannot
# be cloned (not created yet, App not installed on it) just is not part of the
# set; the workspace itself stays usable. Entries need an explicit https url.
# Exit 0 = in sync, 2 = synced with advisories, 1 = blocked.
if [ -f repos.json ]; then
  log "syncing sibling repos from repos.json"
  set +e
  aidlc system workspace-sync
  rc=$?
  set -e
  case "$rc" in
    0) ;;
    2) log "workspace-sync finished with advisories" ;;
    *) log "WARNING: workspace-sync blocked (exit $rc); continuing without the missing sibling repos" ;;
  esac
fi

# Mark Bedrock model access as verified when the task role can actually see
# the configured model; otherwise leave the pending action so doctor reports it.
if [ "${AIDLC_VERIFY_BEDROCK:-1}" = "1" ] && command -v aws >/dev/null; then
  model="${ANTHROPIC_MODEL:-}"
  if [ -n "$model" ] && aws bedrock get-inference-profile --inference-profile-identifier "$model" >/dev/null 2>&1; then
    aidlc config providers --mark-done bedrock-model-access --yes >/dev/null 2>&1 || true
  fi
fi

aidlc doctor --project-dir "$dir" --quiet || log "doctor reported problems (see above); continuing"
log "ready: $dir"
