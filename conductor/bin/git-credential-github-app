#!/usr/bin/env node
// Git credential helper that mints short-lived GitHub App installation tokens.
//
// Configured in the image via GIT_CONFIG_* so every `git` the conductor runs
// against https://github.com asks here. Tokens live ~1h; we cache them on disk
// for 50 minutes so a long Construction stage does not hammer the API.
//
// Env (injected from Secrets Manager by the ECS task definition):
//   GITHUB_APP_ID               numeric app id
//   GITHUB_APP_INSTALLATION_ID  installation id for the org
//   GITHUB_APP_PRIVATE_KEY      PEM (newlines may be escaped as \n)
// Fallback:
//   GITHUB_TOKEN                if set, returned as-is (local dev / PAT)
//
// Only the `get` operation does work; `store`/`erase` are no-ops.

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const crypto = require("node:crypto");

const op = process.argv[2];
if (op !== "get") process.exit(0);

async function main() {
  const input = fs.readFileSync(0, "utf8");
  const attrs = Object.fromEntries(
    input.split("\n").filter(Boolean).map((l) => {
      const i = l.indexOf("=");
      return [l.slice(0, i), l.slice(i + 1)];
    })
  );
  if (attrs.host && attrs.host !== "github.com") return; // not ours

  const token = await getToken();
  if (!token) return;
  process.stdout.write(`username=x-access-token\npassword=${token}\n`);
}

async function getToken() {
  if (process.env.GITHUB_TOKEN) return process.env.GITHUB_TOKEN;

  const appId = process.env.GITHUB_APP_ID;
  const installationId = process.env.GITHUB_APP_INSTALLATION_ID;
  let pem = process.env.GITHUB_APP_PRIVATE_KEY;
  if (!appId || !installationId || !pem) {
    console.error("git-credential-github-app: GITHUB_APP_ID/INSTALLATION_ID/PRIVATE_KEY not set");
    return null;
  }
  pem = pem.replace(/\\n/g, "\n");

  const cacheFile = path.join(os.tmpdir(), `gh-app-token-${appId}-${installationId}.json`);
  try {
    const c = JSON.parse(fs.readFileSync(cacheFile, "utf8"));
    if (Date.now() < c.expiresAt - 60_000) return c.token;
  } catch {}

  const now = Math.floor(Date.now() / 1000);
  const jwt = signJwt({ iat: now - 60, exp: now + 9 * 60, iss: appId }, pem);

  const res = await fetch(
    `https://api.github.com/app/installations/${installationId}/access_tokens`,
    {
      method: "POST",
      headers: {
        Authorization: `Bearer ${jwt}`,
        Accept: "application/vnd.github+json",
        "User-Agent": "aidlc-conductor",
      },
    }
  );
  if (!res.ok) {
    console.error(`git-credential-github-app: ${res.status} ${await res.text()}`);
    return null;
  }
  const body = await res.json();
  // Cache for 50 min regardless of what GitHub says (tokens are 60 min).
  fs.writeFileSync(
    cacheFile,
    JSON.stringify({ token: body.token, expiresAt: Date.now() + 50 * 60_000 }),
    { mode: 0o600 }
  );
  return body.token;
}

function signJwt(payload, pem) {
  const b64 = (o) => Buffer.from(JSON.stringify(o)).toString("base64url");
  const data = `${b64({ alg: "RS256", typ: "JWT" })}.${b64(payload)}`;
  const sig = crypto.sign("RSA-SHA256", Buffer.from(data), pem).toString("base64url");
  return `${data}.${sig}`;
}

main().catch((e) => {
  console.error(`git-credential-github-app: ${e.message}`);
  process.exit(0); // never block git with a hard failure; it will prompt/fail itself
});
