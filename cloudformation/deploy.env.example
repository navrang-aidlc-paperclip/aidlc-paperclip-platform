# Copy to deploy.env (gitignored) and fill in.
AWS_REGION=eu-central-1
NAME=aidlc
VPC_CIDR=10.42.0.0/16

# --- data stack
DB_INSTANCE_CLASS=db.t4g.medium
DB_ENGINE_VERSION=17.9
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/navrang-aidlc-conductor.private-key.pem

# --- paperclip stack
# Pilot login is Paperclip's own accounts. No Entra app.
DOMAIN=aidlc.example.com
HOSTED_ZONE_ID=            # empty if DNS is not in Route53
DISABLE_SIGN_UP=false      # flip to true after first Owner sign-up
DESIRED_COUNT=1
# IMAGE is printed by the build workflow / docs/runbook.md
IMAGE=

# Verify with: aws bedrock list-inference-profiles --region eu-central-1 --query 'inferenceProfileSummaries[].inferenceProfileId'
BEDROCK_PRIMARY_MODEL=eu.anthropic.claude-sonnet-4-6
BEDROCK_OPUS_MODEL=eu.anthropic.claude-sonnet-4-6
BEDROCK_SONNET_MODEL=eu.anthropic.claude-sonnet-4-6
BEDROCK_HAIKU_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0

GITHUB_ACTIONS_REPO=navrang-aidlc-paperclip/aidlc-platform
