#!/usr/bin/env python3
"""Print the current ECS task-role credentials for Claude Code.

Claude Code's awsCredentialExport setting runs this at session start and again
before the returned Expiration. ECS rotates the task-role token about every
six hours at the container credentials endpoint; reading it here lets one
AI-DLC session outlive a single token.

Stdout is the credential JSON Claude expects. Stderr stays free of credential
material.
"""

from __future__ import annotations

import json
import os
import sys
import urllib.request


def to_claude(payload: dict) -> dict:
    access = payload.get("AccessKeyId")
    secret = payload.get("SecretAccessKey")
    token = payload.get("Token") or payload.get("SessionToken")
    if not access or not secret or not token:
        raise ValueError("credential response is missing access key, secret, or session token")
    credentials = {
        "AccessKeyId": access,
        "SecretAccessKey": secret,
        "SessionToken": token,
    }
    expiration = payload.get("Expiration")
    if expiration:
        credentials["Expiration"] = expiration
    return {"Credentials": credentials}


def _endpoint() -> tuple[str, dict[str, str]]:
    relative = os.environ.get("AWS_CONTAINER_CREDENTIALS_RELATIVE_URI")
    full = os.environ.get("AWS_CONTAINER_CREDENTIALS_FULL_URI")
    headers: dict[str, str] = {}
    if relative:
        url = "http://169.254.170.2" + relative
    elif full:
        url = full
    else:
        raise RuntimeError("no ECS container credentials URI in the environment")

    token = os.environ.get("AWS_CONTAINER_AUTHORIZATION_TOKEN")
    token_file = os.environ.get("AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE")
    if not token and token_file:
        with open(token_file, encoding="utf-8") as handle:
            token = handle.read().strip()
    if token:
        headers["Authorization"] = token
    return url, headers


def main() -> None:
    try:
        url, headers = _endpoint()
        request = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(request, timeout=5) as response:
            payload = json.load(response)
        exported = to_claude(payload)
    except Exception as exc:
        kind = type(exc).__name__
        sys.stderr.write(f"ecs-task-credentials: {kind}\n")
        sys.exit(1)
    json.dump(exported, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
